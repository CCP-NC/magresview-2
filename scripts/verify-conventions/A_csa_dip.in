# Static powder, 400 MHz (1H), detect the first nucleus. Run from the output
# directory; verify.py does that.
source A_csa_dip.spinsys
par {
    proton_frequency 400e6
    start_operator I1x
    detect_operator I1p
    spin_rate 0
    np 2048
    sw 200000
    num_cores 4
    crystal_file zcw4180
    gamma_angles 1
    verbose 0
}
proc pulseq {} {
    global par
    acq_block { delay [expr 1e6/$par(sw)] }
}
proc main {} {
    global par
    set f [fsimpson]
    fsave $f A_csa_dip_fid.dat -xreim
}
