#$magres-abinitio-v1.0
# Test fixture: alpha-quartz, magnetic shielding only.
# Paired with quartz.efg.magres to exercise complementary-model merging.
# Geometry is experimental alpha-quartz (P3_221, a=4.9134, c=5.4052);
# tensor values are synthetic and carry no physical meaning.
[calculation]
calc_code QE-GIPAW
calc_code_version 1.2.0
calc_prefix quartz
calc_xcfunctional PBE
calc_cutoffenergy 60.00 Ry
calc_kpoint_mp_grid 4 4 3
calc_pspot Si.pbe-tm-gipaw.UPF
calc_pspot O.pbe-tm-gipaw.UPF
[/calculation]
