#$magres-abinitio-v1.0
# Test fixture: alpha-quartz, electric field gradients only.
# Paired with quartz.nmr.magres to exercise complementary-model merging.
# Same geometry and calculation parameters as the shielding run, with one
# extra metadata key (calc_code_version_git) to check that non-conflicting
# extras do not block a merge.
[calculation]
calc_code QE-GIPAW
calc_code_version 1.2.0
calc_code_version_git 717e55c36f28
calc_prefix quartz
calc_xcfunctional PBE
calc_cutoffenergy 60.0 Ry
calc_kpoint_mp_grid 4 4 3
calc_pspot Si.pbe-tm-gipaw.UPF
calc_pspot O.pbe-tm-gipaw.UPF
[/calculation]
